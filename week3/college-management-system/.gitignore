# =========================
# Uploads (user generated)
# Ship only the default assets so a fresh clone renders correctly;
# everything else stays local.
# =========================
backend/uploads/*
!backend/uploads/admin/
!backend/uploads/admin/default.png
!backend/uploads/admin/signature.png
!backend/uploads/admin/admin.jpg
!backend/uploads/faculties/
!backend/uploads/faculties/default.png
!backend/uploads/students/
!backend/uploads/students/default.png

